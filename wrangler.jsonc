{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "not-app-db",
      "database_id": "e64cd92c-bc71-4692-b331-a0e3e997228b",
      "migrations_dir": "migrations"
    }
  ],
  // Her dakika süresi gelen bildirimleri gönderir.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "BCtfbIHH_zDeuaKf-8Cjdm5-CblPjcpnh5_Q1nM7K9YBwyEewNox5AEiornbnWaq_jGgK8DpHAVMT1wdCyFpL5Q",
    "VAPID_SUBJECT": "https://not-app.armanalis.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
